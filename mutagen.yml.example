# Kopie nach mutagen.yml nur noch für manuelle Mutagen-Projekte.
# Bevorzugt: einmal scripts/c2-sync/setup.command bzw. setup.cmd doppelklicken.
sync:
  c2-gallery:
    alpha: "~/c2-deploy"
    beta: "HOST:httpdocs/galerie"
    mode: "one-way-safe"
    permissions:
      defaultFileMode: 0644
      defaultDirectoryMode: 0755
    ignore:
      vcs: true
      paths:
        - ".DS_Store"
  c2-gallery-private:
    alpha: "~/c2-private"
    beta: "HOST:httpdocs/pictures-private"
    mode: "one-way-replica"
    permissions:
      defaultFileMode: 0644
      defaultDirectoryMode: 0755
    ignore:
      vcs: true
      paths:
        - ".DS_Store"
